#!/bin/sh
# preinst script for APPLICATION_PACKAGE: jpackage's own, plus the menu directory its postinst needs.
#
# jpackage's postinst registers the menu entry with xdg-desktop-menu, which aborts the whole install with «No
# writable system menu directory found» where /usr/share/desktop-directories does not exist (minimal systems, the
# GitHub runner; Distribución step 0b). Creating it here, before the files are unpacked, lets the postinst finish.
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

package_type=deb
LAUNCHER_AS_SERVICE_SCRIPTS

case "$1" in
    install|upgrade)
mkdir -p /usr/share/desktop-directories
if [ -n "$2" ]; then
  true; LAUNCHER_AS_SERVICE_COMMANDS_UNINSTALL
fi
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0

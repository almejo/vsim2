<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  A hand-written fixture for the geometry step: one circuit per case, every end wired as Logisim places it.

  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Base" name="6"/>
  <main name="gate"/>
  <options/>
  <circuit name="gate">
    <wire from="(100,90)" to="(170,90)"/>
    <wire from="(100,110)" to="(170,110)"/>
    <wire from="(200,100)" to="(300,100)"/>
    <comp lib="0" loc="(100,90)" name="Pin"/>
    <comp lib="0" loc="(100,110)" name="Pin"/>
    <comp lib="1" loc="(200,100)" name="AND Gate"><a name="size" val="30"/><a name="inputs" val="2"/></comp>
    <comp lib="0" loc="(300,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
  <circuit name="mux">
    <wire from="(100,90)" to="(170,90)"/>
    <wire from="(100,110)" to="(170,110)"/>
    <wire from="(180,40)" to="(180,80)"/>
    <wire from="(200,100)" to="(300,100)"/>
    <comp lib="0" loc="(100,90)" name="Pin"/>
    <comp lib="0" loc="(100,110)" name="Pin"/>
    <comp lib="0" loc="(180,40)" name="Pin"><a name="facing" val="south"/></comp>
    <comp lib="2" loc="(200,100)" name="Multiplexer"><a name="selloc" val="tr"/><a name="enable" val="false"/></comp>
    <comp lib="0" loc="(300,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
  <circuit name="splitters">
    <wire from="(100,100)" to="(200,100)"/>
    <wire from="(220,80)" to="(300,80)"/>
    <wire from="(220,90)" to="(350,90)"/>
    <comp lib="0" loc="(100,100)" name="Pin"><a name="width" val="4"/></comp>
    <comp lib="0" loc="(200,100)" name="Splitter">
      <a name="incoming" val="4"/><a name="bit1" val="0"/><a name="bit2" val="1"/><a name="bit3" val="1"/>
    </comp>
    <comp lib="0" loc="(300,80)" name="Pin">
      <a name="facing" val="west"/><a name="output" val="true"/><a name="width" val="2"/>
    </comp>
    <comp lib="0" loc="(350,90)" name="Pin">
      <a name="facing" val="west"/><a name="output" val="true"/><a name="width" val="2"/>
    </comp>
    <wire from="(200,250)" to="(200,300)"/>
    <wire from="(220,320)" to="(220,400)"/>
    <wire from="(210,320)" to="(210,450)"/>
    <comp lib="0" loc="(200,250)" name="Pin"><a name="facing" val="south"/><a name="width" val="4"/></comp>
    <comp lib="0" loc="(200,300)" name="Splitter">
      <a name="facing" val="south"/>
      <a name="incoming" val="4"/><a name="bit1" val="0"/><a name="bit2" val="1"/><a name="bit3" val="1"/>
    </comp>
    <comp lib="0" loc="(220,400)" name="Pin">
      <a name="facing" val="north"/><a name="output" val="true"/><a name="width" val="2"/>
    </comp>
    <comp lib="0" loc="(210,450)" name="Pin">
      <a name="facing" val="north"/><a name="output" val="true"/><a name="width" val="2"/>
    </comp>
    <wire from="(200,500)" to="(300,500)"/>
    <wire from="(100,510)" to="(180,510)"/>
    <wire from="(50,520)" to="(180,520)"/>
    <comp lib="0" loc="(300,500)" name="Pin"><a name="facing" val="west"/><a name="width" val="4"/></comp>
    <comp lib="0" loc="(200,500)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="4"/><a name="bit1" val="0"/><a name="bit2" val="1"/><a name="bit3" val="1"/>
    </comp>
    <comp lib="0" loc="(100,510)" name="Pin">
      <a name="output" val="true"/><a name="width" val="2"/>
    </comp>
    <comp lib="0" loc="(50,520)" name="Pin">
      <a name="output" val="true"/><a name="width" val="2"/>
    </comp>
    <wire from="(200,700)" to="(200,750)"/>
    <wire from="(190,600)" to="(190,680)"/>
    <wire from="(180,550)" to="(180,680)"/>
    <comp lib="0" loc="(200,750)" name="Pin"><a name="facing" val="north"/><a name="width" val="4"/></comp>
    <comp lib="0" loc="(200,700)" name="Splitter">
      <a name="facing" val="north"/>
      <a name="incoming" val="4"/><a name="bit1" val="0"/><a name="bit2" val="1"/><a name="bit3" val="1"/>
    </comp>
    <comp lib="0" loc="(190,600)" name="Pin">
      <a name="facing" val="south"/><a name="output" val="true"/><a name="width" val="2"/>
    </comp>
    <comp lib="0" loc="(180,550)" name="Pin">
      <a name="facing" val="south"/><a name="output" val="true"/><a name="width" val="2"/>
    </comp>
  </circuit>
  <circuit name="tee">
    <wire from="(100,100)" to="(150,100)"/>
    <wire from="(150,100)" to="(270,100)"/>
    <wire from="(150,100)" to="(150,150)"/>
    <wire from="(150,150)" to="(270,150)"/>
    <wire from="(300,100)" to="(350,100)"/>
    <wire from="(300,150)" to="(350,150)"/>
    <comp lib="0" loc="(100,100)" name="Pin"/>
    <comp lib="1" loc="(300,100)" name="NOT Gate"/>
    <comp lib="1" loc="(300,150)" name="NOT Gate"/>
    <comp lib="0" loc="(350,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
    <comp lib="0" loc="(350,150)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
  <circuit name="not in front">
    <wire from="(100,90)" to="(170,90)"/>
    <wire from="(100,110)" to="(160,110)"/>
    <wire from="(200,100)" to="(300,100)"/>
    <comp lib="0" loc="(100,90)" name="Pin"/>
    <comp lib="0" loc="(100,110)" name="Pin"/>
    <comp lib="1" loc="(200,100)" name="OR Gate">
      <a name="size" val="30"/><a name="inputs" val="2"/><a name="negate1" val="true"/>
    </comp>
    <comp lib="0" loc="(300,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
  <circuit name="texts">
    <comp lib="6" loc="(100,100)" name="Text"><a name="text" val="hola"/></comp>
    <comp lib="0" loc="(200,100)" name="Probe"><a name="label" val="pc"/></comp>
    <comp lib="0" loc="(300,100)" name="Probe"/>
  </circuit>
  <circuit name="junction">
    <wire from="(50,100)" to="(100,100)"/>
    <wire from="(120,90)" to="(150,90)"/>
    <comp lib="0" loc="(50,100)" name="Pin"/>
    <comp lib="0" loc="(100,100)" name="Splitter"><a name="incoming" val="1"/><a name="fanout" val="1"/></comp>
    <comp lib="0" loc="(150,90)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
  <circuit name="instance">
    <wire from="(100,100)" to="(170,100)"/>
    <wire from="(200,100)" to="(300,100)"/>
    <comp lib="0" loc="(100,100)" name="Pin"/>
    <comp loc="(200,100)" name="inner"/>
    <comp lib="0" loc="(300,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
  <circuit name="untidy">
    <wire from="(100,100)" to="(150,100)"/>
    <wire from="(150,100)" to="(200,100)"/>
    <wire from="(150,60)" to="(150,100)"/>
    <comp lib="0" loc="(100,100)" name="Pin"/>
    <comp lib="0" loc="(200,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
  <circuit name="inner">
    <comp lib="0" loc="(100,100)" name="Pin"/>
    <comp lib="0" loc="(300,100)" name="Pin"><a name="facing" val="west"/><a name="output" val="true"/></comp>
  </circuit>
</project>

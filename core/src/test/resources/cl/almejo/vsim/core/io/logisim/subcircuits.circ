<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  A hand-written fixture for subcircuits: «top» uses «middle» and «leaf», «middle» uses «leaf»; «leaf» has a label
  and no appearance, «middle» has its own drawing.

  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <main name="top"/>
  <circuit name="top">
    <a name="circuit" val="top"/>
    <comp loc="(200,100)" name="middle"/>
    <comp loc="(200,300)" name="leaf"/>
  </circuit>
  <circuit name="middle">
    <a name="circuit" val="middle"/>
    <a name="clabelup" val="north"/>
    <appear>
      <rect fill="none" height="40" stroke="#000000" stroke-width="2" width="40" x="50" y="50"/>
      <text font-family="SansSerif" font-size="12" text-anchor="middle" x="70" y="75">M</text>
      <circ-port height="8" pin="100,100" width="8" x="46" y="66"/>
      <circ-port height="10" pin="300,100" width="10" x="85" y="65"/>
      <circ-anchor facing="east" height="6" width="6" x="87" y="67"/>
    </appear>
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="label" val="a"/>
    </comp>
    <comp lib="0" loc="(300,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="y"/>
    </comp>
    <comp loc="(200,100)" name="leaf"/>
  </circuit>
  <circuit name="leaf">
    <a name="circuit" val="leaf"/>
    <a name="clabel" val="L"/>
    <comp lib="0" loc="(100,100)" name="Pin"/>
    <comp lib="0" loc="(100,150)" name="Pin"/>
    <comp lib="0" loc="(300,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </comp>
  </circuit>
</project>

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  A hand-written fixture for the reader: two circuits, splitters, a mux, texts and an appearance.

  <lib desc="#Wiring" name="0">
    <tool name="Splitter">
      <a name="facing" val="south"/>
    </tool>
    <tool name="Constant">
      <a name="width" val="2"/>
      <a name="value" val="0x3"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Base" name="6">
    <tool name="Text Tool">
      <a name="text" val=""/>
      <a name="font" val="SansSerif plain 12"/>
    </tool>
  </lib>
  <main name="top"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
  </options>
  <circuit name="half">
    <a name="circuit" val="half"/>
    <appear>
      <rect fill="none" height="40" stroke="#000000" stroke-width="2" width="30" x="50" y="50"/>
      <rect fill="#ffffff" height="20" rx="5" ry="5" stroke="#000000" width="20" x="55" y="55"/>
      <ellipse cx="60" cy="70" fill="#000000" rx="5" ry="4" stroke="none"/>
      <line fill="none" stroke="#808080" x1="50" x2="80" y1="60" y2="60"/>
      <polyline fill="none" points="50,50 60,40 70,50" stroke="#000000"/>
      <polygon fill="#ff0000" points="50,90 60,100 70,90" stroke="#000000" stroke-width="1"/>
      <path d="M61,51 Q65,61 69,51" fill="none" stroke="#808080" stroke-width="2"/>
      <text font-family="SansSerif" font-size="14" font-weight="bold" font-style="italic" text-anchor="start" x="65" y="75">Half</text>
      <circ-port height="8" pin="100,200" width="8" x="46" y="66"/>
      <circ-port height="10" pin="300,200" width="10" x="75" y="65"/>
      <circ-anchor facing="east" height="6" width="6" x="77" y="67"/>
      <blink x="0" y="0"/>
    </appear>
    <wire from="(100,200)" to="(150,200)"/>
    <comp lib="0" loc="(100,200)" name="Pin"/>
    <comp lib="0" loc="(300,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="y"/>
    </comp>
  </circuit>
  <circuit name="top">
    <a name="circuit" val="top"/>
    <wire from="(60,40)" to="(60,90)"/>
    <wire from="(20,40)" to="(60,40)"/>
    <comp lib="1" loc="(200,100)" name="AND Gate"/>
    <comp lib="1" loc="(200,200)" name="OR Gate">
      <a name="inputs" val="2"/>
      <a name="negate1" val="true"/>
    </comp>
    <comp lib="0" loc="(300,100)" name="Constant"/>
    <comp lib="0" loc="(400,100)" name="Splitter">
      <a name="fanout" val="4"/>
      <a name="incoming" val="32"/>
    </comp>
    <comp lib="0" loc="(400,300)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="fanout" val="3"/>
      <a name="incoming" val="8"/>
      <a name="bit0" val="2"/>
      <a name="bit5" val="none"/>
      <a name="bit6" val="9"/>
    </comp>
    <comp lib="2" loc="(500,100)" name="Multiplexer">
      <a name="width" val="32"/>
    </comp>
    <comp lib="6" loc="(600,100)" name="Text">
      <a name="text" val="Hola"/>
      <a name="font" val="SansSerif bolditalic 14"/>
    </comp>
    <comp lib="6" loc="(600,200)" name="Text"/>
    <comp loc="(700,100)" name="half"/>
    <comp lib="9" loc="(800,100)" name="Ghost"/>
  </circuit>
</project>

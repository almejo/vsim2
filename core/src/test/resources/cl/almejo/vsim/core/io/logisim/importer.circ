<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  A hand-written fixture for the importer: «top» (the main circuit) uses «nand» and «inverter», «nand» uses
  «inverter». «inverter» has blank pin names and no appearance; «nand» has its own drawing.

  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <main name="top"/>
  <circuit name="top">
    <a name="circuit" val="top"/>
    <wire from="(100,90)" to="(180,90)"/>
    <wire from="(180,90)" to="(260,90)"/>
    <wire from="(100,110)" to="(260,110)"/>
    <wire from="(180,90)" to="(180,300)"/>
    <wire from="(180,300)" to="(270,300)"/>
    <wire from="(300,100)" to="(500,100)"/>
    <wire from="(300,300)" to="(500,300)"/>
    <comp lib="0" loc="(100,90)" name="Pin">
      <a name="label" val="A"/>
    </comp>
    <comp lib="0" loc="(100,110)" name="Pin">
      <a name="label" val="B"/>
    </comp>
    <comp loc="(300,100)" name="nand"/>
    <comp loc="(300,300)" name="inverter"/>
    <comp lib="0" loc="(500,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Y"/>
    </comp>
    <comp lib="0" loc="(500,300)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Z"/>
    </comp>
  </circuit>
  <circuit name="nand">
    <a name="circuit" val="nand"/>
    <appear>
      <rect fill="none" height="60" stroke="#000000" stroke-width="2" width="40" x="50" y="50"/>
      <text font-family="SansSerif" font-size="12" text-anchor="middle" x="70" y="85">&amp;</text>
      <circ-port height="8" pin="100,100" width="8" x="46" y="66"/>
      <circ-port height="8" pin="100,140" width="8" x="46" y="86"/>
      <circ-port height="10" pin="400,100" width="10" x="85" y="75"/>
      <circ-anchor facing="east" height="6" width="6" x="87" y="77"/>
    </appear>
    <wire from="(100,100)" to="(150,100)"/>
    <wire from="(100,140)" to="(150,140)"/>
    <wire from="(200,120)" to="(270,120)"/>
    <wire from="(300,120)" to="(340,120)"/>
    <wire from="(340,120)" to="(340,100)"/>
    <wire from="(340,100)" to="(400,100)"/>
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="label" val="a"/>
    </comp>
    <comp lib="0" loc="(100,140)" name="Pin">
      <a name="label" val="b"/>
    </comp>
    <comp lib="1" loc="(200,120)" name="AND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp loc="(300,120)" name="inverter"/>
    <comp lib="0" loc="(400,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="y"/>
    </comp>
  </circuit>
  <circuit name="inverter">
    <a name="circuit" val="inverter"/>
    <a name="clabel" val="NOT"/>
    <wire from="(100,100)" to="(170,100)"/>
    <wire from="(200,100)" to="(300,100)"/>
    <comp lib="0" loc="(100,100)" name="Pin"/>
    <comp lib="1" loc="(200,100)" name="NOT Gate"/>
    <comp lib="0" loc="(300,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </comp>
  </circuit>
</project>
